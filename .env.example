# Credenciais da Meta Marketing API — copie para .env e preencha.
# NUNCA faça commit do arquivo .env real (ele está no .gitignore).

# Token de acesso (System User token de longa duração é o recomendado).
# Permissões necessárias: ads_management, instagram_basic, pages_read_engagement,
# pages_show_list, business_management.
META_ACCESS_TOKEN=

# ID da conta de anúncios. Com ou sem o prefixo "act_".
# Ex.: act_1234567890
META_AD_ACCOUNT_ID=

# ID da conta profissional do Instagram (Instagram User ID).
# Obrigatório para listar posts e criar anúncios a partir de posts do Instagram.
META_IG_USER_ID=

# ID da Página do Facebook ligada à conta (opcional; usado para posts de Página).
META_PAGE_ID=

# Versão da Graph API (opcional). Padrão: v21.0
# META_API_VERSION=v21.0
